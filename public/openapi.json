{
	"openapi": "3.0.3",
	"info": {
		"title": "Chismógrafo API REST 📓",
		"description": "API REST y widgets incrustables del Chismógrafo para auditar plataformas de e-commerce, pasarelas de pago, aplicaciones y plugins instalados, infraestructura, píxeles de seguimiento, geolocalización de servidores y velocidad Lighthouse móvil en cualquier sitio web... ¡Todo sin que se enteren! 🤫",
		"version": "1.13.0",
		"contact": {
			"name": "Equipo Rífatela",
			"url": "https://rifatela.lol"
		}
	},
	"servers": [
		{
			"url": "http://localhost:3000",
			"description": "Servidor local de desarrollo"
		},
		{
			"url": "https://chismografo.rifatela.lol",
			"description": "Servidor de producción en la nube"
		}
	],
	"paths": {
		"/api/detect": {
			"post": {
				"summary": "Sacarle el chisme completo a un sitio (POST) 🕵️",
				"description": "Envía una URL en el cuerpo JSON para analizar estructura DOM, CMS/tecnología, apps instaladas, pasarelas de pago, píxeles, infraestructura, geolocalización y capturas de pantalla.",
				"tags": [
					"Detección"
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/DetectRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Expediente chismoso completado exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DetectResponse"
								}
							}
						}
					},
					"400": {
						"description": "URL faltante o formato inválido",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"403": {
						"description": "Denegado por restricciones de CORS",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"422": {
						"description": "Error al conectar con el sitio objetivo",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DetectResponse"
								}
							}
						}
					}
				}
			},
			"get": {
				"summary": "Sacarle el chisme completo a un sitio (GET) 🕵️",
				"description": "Envía una URL como parámetro query para analizar firmas de e-commerce, apps, pasarelas, píxeles y geolocalizar el servidor.",
				"tags": [
					"Detección"
				],
				"parameters": [
					{
						"name": "url",
						"in": "query",
						"required": true,
						"description": "La URL del sitio web a auditar",
						"schema": {
							"type": "string",
							"format": "uri",
							"example": "https://tienda-ejemplo.com"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Expediente chismoso completado exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DetectResponse"
								}
							}
						}
					},
					"400": {
						"description": "URL faltante o formato inválido",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"422": {
						"description": "Error al conectar con el sitio objetivo"
					}
				}
			}
		},
		"/api/rules/test": {
			"post": {
				"summary": "Probar lote de reglas dinámicas 🧪",
				"description": "Evalúa un lote de reglas de detección (detectionRules) personalizadas contra una URL o código HTML en vivo.",
				"tags": [
					"Reglas"
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RulesTestRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Resultados de evaluación de las reglas",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RulesTestResponse"
								}
							}
						}
					},
					"400": {
						"description": "Petición inválida: Se requiere URL o HTML y al menos una regla",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
