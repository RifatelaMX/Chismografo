					}
				}
			},
			"RulesTestRequest": {
				"type": "object",
				"required": [
					"detectionRules"
				],
				"properties": {
					"url": {
						"type": "string",
						"format": "uri",
						"example": "https://shopify.com"
					},
					"html": {
						"type": "string",
						"description": "Código HTML crudo para evaluar las reglas"
					},
					"detectionRules": {
						"type": "array",
						"items": {
							"type": "object",
							"required": [
								"type",
								"pattern"
							],
							"properties": {
								"type": {
									"type": "string",
									"enum": [
										"script-src",
										"script-content",
										"meta",
										"header",
										"dom-element",
										"js-variable"
									]
								},
								"pattern": {
									"type": "string",
									"example": "cdn\\.shopify\\.com"
								},
								"key": {
									"type": "string",
									"example": "generator"
								},
								"description": {
									"type": "string",
									"example": "Firma de script CDN detectada"
								}
							}
						}
					}
				}
			},
			"RulesTestResponse": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean"
					},
					"matched": {
						"type": "boolean"
					},
					"score": {
						"type": "number",
						"example": 1
					},
					"results": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"rule": {
									"type": "object"
								},
								"passed": {
									"type": "boolean"
								},
								"evidence": {
									"type": "string"
								}
							}
						}
					}
				}
			},
			"ErrorResponse": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
						"example": false
					},
					"error": {
						"type": "string",
						"example": "URL inválida o no proporcionada"
					}
				}
			}
		}
	}
