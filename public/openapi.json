								}
							}
						}
					},
					"400": {
						"description": "Correo inválido o datos incompletos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
