		"/api/screenshot": {
			"get": {
				"summary": "Generar captura de pantalla de la tienda 📸",
				"description": "Genera una captura visual en formato desktop o móvil de la página de inicio.",
				"tags": [
					"Capturas"
				],
				"parameters": [
					{
						"$ref": "#/components/parameters/UrlQueryParam"
					},
					{
						"name": "device",
						"in": "query",
						"required": false,
						"description": "Dispositivo para la captura ('desktop' o 'mobile')",
						"schema": {
							"type": "string",
							"enum": [
								"desktop",
								"mobile"
							],
							"default": "desktop"
						}
					}
				],
				"responses": {
					"200": {
						"description": "URL o base64 de la captura generada",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ScreenshotResponse"
								}
							}
						}
					}
				}
			},
			"post": {
				"summary": "Generar captura de pantalla de la tienda (POST) 📸",
				"tags": [
					"Capturas"
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": [
									"url"
								],
								"properties": {
									"url": {
										"type": "string",
										"format": "uri"
									},
									"device": {
										"type": "string",
										"enum": [
											"desktop",
											"mobile"
										],
										"default": "desktop"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Captura generada exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ScreenshotResponse"
								}
							}
						}
					}
				}
			}
		},
