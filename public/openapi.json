	"components": {
		"parameters": {
			"UrlQueryParam": {
				"name": "url",
				"in": "query",
				"required": true,
				"description": "La dirección URL de la tienda a auditar",
				"schema": {
					"type": "string",
					"format": "uri",
					"example": "https://tienda-ejemplo.com"
				}
			}
		},
		"schemas": {
			"DetectRequest": {
				"type": "object",
				"required": [
					"url"
				],
				"properties": {
					"url": {
						"type": "string",
						"format": "uri",
						"description": "Dirección URL del sitio web a analizar",
						"example": "https://tienda-ejemplo.com"
					}
				}
			},
			"DetectResponse": {
				"type": "object",
				"properties": {
