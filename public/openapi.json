						"description": "Reporte enviado exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"success": {
											"type": "boolean",
											"example": true
										},
										"message": {
											"type": "string",
											"example": "¡Reporte enviado exitosamente! Revisa tu bandeja de entrada."
										}
