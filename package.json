{
	"name": "chismografo",
	"version": "1.7.2",
	"description": "Chismógrafo es una aplicación para obtener la pila tecnológica de un sitio web.",
	"repository": {
		"type": "git",
		"url": "https://github.com/RifatelaMX/Chismografo.git"
	},
	"type": "module",
	"main": "server.js",
	"bin": {
		"chismografo": "./cli/bin/index.js"
	},
	"scripts": {
		"start": "node server.js",
		"dev": "chismografo dev",
		"dev:vercel": "vercel dev",
		"vercel:pull": "vercel env pull .env.development.local",
		"maildev": "maildev",
		"cli": "chismografo",
		"build": "node ./cli/bin/index.js build-index",
		"test": "node test-detector.js",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"commit:check": "node scripts/validate-commit-msg.js",
		"versions": "node scripts/update-versions.js --check",
		"versions:dry": "node scripts/update-versions.js --dry-run",
		"release": "semantic-release"
	},
	"keywords": [
		"scraper",
		"ecommerce",
		"chismografo",
		"shopify",
		"magento",
		"woocommerce",
		"prestashop",
		"vtex",
		"api"
	],
	"author": "Rífatela",
	"license": "AGPL-3.0-only",
	"dependencies": {
		"axios": "^1.20.0",
		"cheerio": "^1.2.0",
		"cors": "^2.8.6",
		"dotenv": "^16.6.1",
		"express": "^4.22.2",
		"geoip-lite": "^2.0.3",
		"morgan": "^1.12.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.0.6",
		"screenshotmachine": "^2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"conventional-changelog-conventionalcommits": "^8.0.0",
		"maildev": "^2.2.1",
		"semantic-release": "^25.0.9"
	}
}
