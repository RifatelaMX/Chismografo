{
	"name": "POWR Contact Form Builder",
	"developer": "POWR",
	"category": "Formularios / Contacto",
	"compatibleCMS": ["Shopify"],
	"web": "https://www.powr.io",
	"appStores": [
		{
			"cms": "Shopify",
			"link": "powr-form-builder"
		}
	],
	"logo": {
