{
  "name": " Klaviyo: marketing email y SMS ",
  "developer": "Klaviyo",
  "category": "Email Marketing",
  "compatibleCMS": [
    "Shopify",
    "Magento",
    "WooCommerce",
    "PrestaShop",
    "VTEX"
  ],
  "web": "https://www.klaviyo.com",
  "appStores": [
    {
      "cms": "Shopify",
      "link": "klaviyo-email-marketing"
    }
  ],
  "logo": {
    "id": "klaviyo.com",
    "provider": "logodev"
  },
  "detectionRules": [
    {
      "type": "script-src",
      "pattern": "klaviyo\\.js|static\\.klaviyo\\.com",
      "description": "Klaviyo integration script or resource detected"
    }
  ]
}
