{
  "name": "Google Analytics",
  "category": "Píxeles / Tracking",
  "web": "https://analytics.google.com/",
  "logo": "analytics.google.com",
  "detectionRules": [
    {
      "type": "script-src",
      "pattern": "googletagmanager\\.com\\/gtag\\/js",
      "description": "Google Analytics (gtag.js) detectado",
      "weight": 1.0
    },
    {
      "type": "script-src",
      "pattern": "google-analytics\\.com\\/analytics\\.js",
      "description": "Google Analytics (analytics.js) detectado",
      "weight": 1.0
    },
    {
      "type": "script-content",
      "pattern": "gtag\\('config'",
      "description": "Google Analytics configuration detectado",
      "weight": 0.8
    }
  ]
}
