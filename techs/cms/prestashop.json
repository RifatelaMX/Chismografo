{
	"$schema": "../../schemas/cms-v2.schema.json",
	"id": "prestashop",
	"chismografo": {
		"tipo": 2,
		"version": 1,
		"ultimaActualizacion": "2026-09-11",
		"revision": 0,
		"entorno": 0
	},
	"acercaDe": {
		"detallesGenerales": {
			"nombre": "PrestaShop",
			"web": "https://www.prestashop.com",
			"logo": {
				"id": "prestashop.com",
				"proveedor": "logodev"
			}
		},
		"precios": []
	},
	"herramienta": {
		"reglasDeteccion": [
			{
				"id": "prestashop-meta-generator",
				"tipo": "meta",
				"llave": "generator",
				"patron": "prestashop",
				"descripcion": "Meta generator contains \"PrestaShop\"",
				"peso": 1
			},
			{
				"id": "prestashop-js-global",
				"tipo": "script-content",
				"patron": "var prestashop\\s*=|prestashop\\s*=",
				"descripcion": "PrestaShop global JS configuration object found",
				"peso": 0.95
			},
			{
				"id": "prestashop-img-path",
				"tipo": "html-attribute",
				"atributo": "src",
				"patron": "\\/img\\/[a-z]\\/[0-9]+",
				"descripcion": "PrestaShop typical product image path structure",
				"peso": 0.6
			},
			{
				"id": "prestashop-path-themes",
				"tipo": "script-src",
				"patron": "^(?!.*wp-content).*\\/themes\\/[^\\/]+\\/assets\\/js\\/",
				"descripcion": "PrestaShop assets folder structure",
				"peso": 0.5
			}
		]
	}
}
