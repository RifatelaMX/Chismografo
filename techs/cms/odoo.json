{
	"id": "odoo",
	"name": "Odoo",
	"web": "https://www.odoo.com",
	"precios": [],
	"logo": {
		"id": "odoo.com",
		"provider": "logodev"
	},
	"detectionRules": [
		{
			"id": "odoo-meta-generator",
			"type": "meta",
			"key": "generator",
			"pattern": "odoo",
			"description": "Meta generator contains \"Odoo\"",
			"weight": 1
		},
		{
			"id": "odoo-web-assets-script",
			"type": "script-src",
			"pattern": "\\/web\\/assets\\/|\\/web\\/content\\/|\\/web\\/static\\/|\\/web_editor\\/static\\/",
			"description": "Scripts loaded from Odoo /web/ structure",
			"weight": 0.95
		},
		{
			"id": "odoo-web-assets-style",
			"type": "link-href",
			"pattern": "\\/web\\/assets\\/|\\/web\\/content\\/|\\/web\\/static\\/|web\\.assets_frontend",
			"description": "Stylesheets loaded from Odoo assets pipeline",
			"weight": 0.95
		},
		{
			"id": "odoo-js-object",
			"type": "script-content",
			"pattern": "(?:window\\.)?odoo\\.(?:define|__DEBUG__|session_info)|var odoo\\s*=",
			"description": "Odoo JavaScript framework or session info defined",
			"weight": 0.95
		},
		{
			"id": "odoo-data-oe-attribute",
			"type": "html-attribute",
			"attribute": "data-oe-model",
			"pattern": ".+",
			"description": "Odoo template engine data-oe-model attribute present",
			"weight": 0.95
		},
		{
			"id": "odoo-html-wrapwrap",
			"type": "html-attribute",
			"attribute": "id",
			"pattern": "^wrapwrap$",
			"description": "Odoo standard root container #wrapwrap",
			"weight": 0.7
		},
		{
			"id": "odoo-header-server",
			"type": "header",
			"key": "server",
			"pattern": "werkzeug|odoo",
			"description": "Server header indicates Werkzeug/Odoo backend",
			"weight": 0.6
		}
	]
}
