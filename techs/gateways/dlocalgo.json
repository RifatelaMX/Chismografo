{
	"name": "dLocal Go",
	"category": "Payment Gateway",
	"web": "https://dlocalgo.com",
	"logo": "dlocalgo.com",
	"detectionRules": [
		{
			"type": "script-src",
			"pattern": "dlocalgo\\.com|dlocalgo-sdk",
			"description": "Script de integración de dLocal Go detectado"
		},
		{
			"type": "html",
			"pattern": "\\bdlocalgo\\b",
			"description": "Clase o marca HTML de dLocal Go detectada"
		}
	]
}
