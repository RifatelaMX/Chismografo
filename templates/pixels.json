{
	"$schema": "../schemas/pixel-v2.schema.json",
	"id": "{{slug}}",
	"chismografo": {
		"tipo": 5,
		"version": 1.0,
		"ultimaActualizacion": "{{fechaActualizacion}}",
		"revision": 0,
		"entorno": 0
	},
	"acercaDe": {
		"detallesGenerales": {
			"nombre": "{{nombre}}",
			"desarrollador": "{{desarrollador}}",
			"categoria": "Píxeles / Tracking",
			"web": "{{web}}",
			"logo": {
				"id": "{{id_logo}}",
				"proveedor": "local"
			}
		},
		"precios": []
	},
	"herramienta": {
		"reglasDeteccion": [
			{
				"tipo": "script-src",
				"patron": "{{slug}}",
				"descripcion": "Script de {{nombre}} detectado",
				"peso": 1.0
			},
			{
				"tipo": "script-content",
				"patron": "{{slug}}",
				"descripcion": "Configuración en línea de {{nombre}} detectada",
				"peso": 0.8
			}
		]
	}
}
