{
	"$schema": "../schemas/gateway-v2.schema.json",
	"id": "{{slug}}",
	"chismografo": {
		"tipo": 3,
		"version": 1.0,
		"ultimaActualizacion": "{{fechaActualizacion}}",
		"revision": 0,
		"entorno": 0
	},
	"acercaDe": {
		"detallesGenerales": {
			"nombre": "{{nombre}}",
			"empresaResponsable": "{{desarrollador}}",
			"web": "{{web}}",
			"categoria": "{{categoria}}",
			"logo": {
				"id": "{{id_logo}}",
				"proveedor": "local"
			}
		},
		"cmsCompatibles": [
			{
				"id": "shopify",
				"comisionMinima": 2,
				"comisionMaxima": 3.6
			}
		],
		"precios": []
	},
	"herramienta": {
		"reglasDeteccion": [
			{
				"tipo": "script-src",
				"patron": "{{scriptPattern}}",
				"descripcion": "Script de integración de {{nombre}} detectado"
			},
			{
				"tipo": "html",
				"patron": "{{htmlPattern}}",
				"descripcion": "Clase o marca HTML de {{nombre}} detectada"
			}
		]
	}
}
