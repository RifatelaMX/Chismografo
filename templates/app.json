{
	"$schema": "../schemas/app-v2.schema.json",
	"id": "{{slug}}",
	"chismografo": {
		"tipo": 1,
		"version": 1.0,
		"ultimaActualizacion": "{{fechaActualizacion}}",
		"revision": 0,
		"entorno": 0
	},
	"acercaDe": {
		"detallesGenerales": {
			"nombre": "{{nombre}}",
			"desarrollador": "{{desarrollador}}",
			"web": "{{web}}",
			"categoria": "{{categoria}}",
			"logo": {
				"id": "{{id_logo}}",
				"proveedor": "local"
			}
		},
		"cmsCompatibles": [
			{
				"id": "shopify",
				"slug": "{{slug}}"
			}
		],
		"calificacion": {
			"puntaje": 5.0,
			"resenas": 0
		},
		"precios": [
			{
				"plan": "Gratis",
				"precio": {
					"monto": 0,
					"moneda": "USD"
				},
				"frecuencia": "mes",
				"features": []
			}
		]
	},
	"herramienta": {
		"reglasDeteccion": [
			{
				"tipo": "script-src",
				"patron": "{{slug}}",
				"descripcion": "Script de integración de {{nombre}} detectado"
			}
		]
	}
}
