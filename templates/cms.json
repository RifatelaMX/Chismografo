{
	"$schema": "../schemas/cms-v2.schema.json",
	"id": "{{slug}}",
	"chismografo": {
		"tipo": 2,
		"version": 1.0,
		"ultimaActualizacion": "{{fechaActualizacion}}",
		"revision": 0,
		"entorno": 0
	},
	"acercaDe": {
		"detallesGenerales": {
			"nombre": "{{nombre}}",
			"web": "{{web}}",
			"logo": {
				"id": "{{id_logo}}",
				"proveedor": "local"
			}
		},
		"precios": []
	},
	"herramienta": {
		"reglasDeteccion": [
			{
				"id": "{{slug}}-meta-generator",
				"tipo": "meta",
				"llave": "generator",
				"patron": "{{slug}}",
				"descripcion": "Meta generador que contiene {{nombre}}",
				"peso": 1.0
			}
		]
	}
}
