{
	"branches": ["main", "master", { "name": "develop", "prerelease": "beta" }],
	"plugins": [
		[
			"@semantic-release/commit-analyzer",
			{
				"preset": "conventionalcommits",
				"releaseRules": [
					{ "breaking": true, "release": "major" },
					{ "type": "feat", "release": "minor" },
					{ "type": "fix", "release": "patch" },
					{ "type": "perf", "release": "patch" },
					{ "type": "refactor", "release": "patch" },
					{ "type": "style", "release": "patch" },
					{ "type": "docs", "release": "patch" },
					{ "type": "chore", "release": "patch" }
				]
			}
		],
		[
			"@semantic-release/release-notes-generator",
			{
				"preset": "conventionalcommits",
				"presetConfig": {
					"types": [
						{ "type": "feat", "section": "✨ Nuevas Características" },
						{ "type": "fix", "section": "🐛 Corrección de Errores" },
						{ "type": "perf", "section": "⚡ Mejoras de Rendimiento" },
						{ "type": "refactor", "section": "♻️ Refactorización" },
						{ "type": "docs", "section": "📝 Documentación" },
						{ "type": "style", "section": "💄 Estilos" },
						{ "type": "test", "section": "✅ Pruebas" },
						{ "type": "build", "section": "📦 Compilación y Empaquetado" },
						{ "type": "ci", "section": "🤖 Integración Continua (CI/CD)" },
						{ "type": "chore", "section": "🔧 Tareas de Mantenimiento" }
					]
				}
			}
		],
		[
			"@semantic-release/changelog",
			{
				"changelogFile": "CHANGELOG.md"
			}
		],
		[
			"@semantic-release/exec",
			{
				"prepareCmd": "node scripts/update-versions.js ${nextRelease.version} ${lastRelease.version}"
			}
		],
		[
			"@semantic-release/npm",
			{
				"npmPublish": false
			}
		],
		[
			"@semantic-release/git",
			{
				"assets": [
					"package.json",
					"package-lock.json",
					"CHANGELOG.md",
					"version.json",
					"public/openapi.json"
				],
				"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
			}
		],
		"@semantic-release/github"
	]
}
