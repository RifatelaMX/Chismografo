# ==============================================================================
# Configuración General del Servidor y Aplicación
# ==============================================================================

# Orígenes permitidos para CORS e incrustación en iframes / widgets (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://chismografo.rifatela.lol

# URL base de la aplicación (usada para enlaces absolutos y widget embeds)
APP_URL=http://localhost:3000


# ==============================================================================
# Servicio de Correos Electrónicos (Email Reports)
# ==============================================================================

# --- Opción 1: Brevo API (Recomendado para Producción) ---
# Obtén tu API Key en: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_EMAIL=contacto@rifatela.lol
BREVO_FROM_NAME="Chismógrafo"

# --- Opción 2: Servidor SMTP (Recomendado para Desarrollo Local con MailDev / Ethereal) ---
# Nota: Si se define BREVO_API_KEY tendrá prioridad sobre SMTP.
# Para desarrollo local con npm run maildev, usa: host=localhost, port=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rifatela.lol
SMTP_FROM_NAME="Chismógrafo"


# ==============================================================================
# Integraciones de Terceros y APIs Opcionales
# ==============================================================================

# Logo.dev — Búsqueda y obtención de logos de alta resolución
# Obtén tus llaves en: https://logo.dev
LOGODEV_PUBLISHABLE_KEY=
LOGODEV_SECRET_KEY=

# Screenshot Machine — Captura de screenshots de sitios web
# Obtén tu customer key en: https://www.screenshotmachine.com
SCREENSHOTMACHINE_KEY=
ENABLE_SCREENSHOTS=true

# RapidAPI Hub — Integración BuiltWith Domain
# Suscripción en: https://rapidapi.com/builtwith-builtwith-default/api/builtwith-domain/
RAPIDAPI_KEY=
